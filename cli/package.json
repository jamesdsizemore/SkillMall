    "dev": "tsx src/index.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@google/generative-ai": "^0.24.1",
    "cheerio": "^1.2.0",
    "gray-matter": "^4.0.3",
    "openai": "^6.38.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5"
  },
  "engines": { "node": ">=18" }
}
