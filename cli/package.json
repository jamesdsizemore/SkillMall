{
  "name": "skill-mall",
  "version": "0.1.0",
  "description": "The SkillMall CLI — browse, deploy, and create Claude Code skills",
  "type": "module",
  "bin": {
    "skill-mall": "./dist/index.js"
  },
  "files": ["dist", "README.md"],
